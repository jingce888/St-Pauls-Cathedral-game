    "typecheck": "tsc --noEmit",
    "shoot": "node tools/shoot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
