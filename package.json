  "version": "1.0.0",
  "description": "A first-person 3D sightseeing walk around and up St Paul's Cathedral, London — built at true scale with three.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
